# FarmTrace Environment Variables Configuration
# Copy this file to .env and fill in your values. NEVER commit .env to version control!

# Ethereum Sepolia RPC URL (e.g., from Alchemy, Infura, or Public Node)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer Private Key for Hardhat (Without 0x prefix or with 0x prefix, ONLY for deployment script)
# NEVER use your real mainnet private key! Use a dedicated testnet developer account.
PRIVATE_KEY=your_sepolia_private_key_here

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Frontend Deployed Contract Address (Vite env variable)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Frontend Default Sepolia RPC fallback for public non-MetaMask reads
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain ID (11155111 for Sepolia)
VITE_CHAIN_ID=11155111
